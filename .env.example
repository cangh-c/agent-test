# Google Cloud Project & Region Configuration (No hardcoded secrets)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Vertex AI Search Data Store ID for SRE Runbooks
VERTEX_SEARCH_DATA_STORE_ID=sentinel-ops-agent-runbooks-ds

# Enable OpenTelemetry Cloud Trace Export
ENABLE_CLOUD_TRACE=true

# Secrets are resolved at runtime from Google Cloud Secret Manager:
# projects/${GOOGLE_CLOUD_PROJECT}/secrets/incident-bug-tracker-api-token/versions/latest
# projects/${GOOGLE_CLOUD_PROJECT}/secrets/incident-pagerduty-webhook-secret/versions/latest
